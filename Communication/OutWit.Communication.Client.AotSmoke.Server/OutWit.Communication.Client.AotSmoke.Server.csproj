<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <!-- Directory.Build.props turns packing on for Release; this is a test harness, not a package. -->
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\OutWit.Communication.Server\OutWit.Communication.Server.csproj" />
    <ProjectReference Include="..\OutWit.Communication.Server.WebSocket\OutWit.Communication.Server.WebSocket.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The contract crosses the process boundary as shared source: the AOT client
         binary and this server hold two different .NET types with one stable
         contract identity (dispatch is by contract-scoped method ids). -->
    <Compile Include="..\OutWit.Communication.Client.AotSmoke\ISmokeService.cs" Link="ISmokeService.cs" />
  </ItemGroup>

  <ItemGroup>
    <!-- For the [ProxyTarget] attribute on the linked contract source. -->
    <PackageReference Include="OutWit.Common.Proxy" />
  </ItemGroup>

</Project>
