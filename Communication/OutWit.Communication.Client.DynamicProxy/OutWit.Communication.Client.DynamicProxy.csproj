<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
	  <TargetFrameworks>net10.0;net9.0;net8.0;net7.0;net6.0</TargetFrameworks>

	  <Version>3.0.0</Version>

	  <Description>Runtime dynamic proxy support (Castle.Core) for the WitRPC client. Reference this package to use GetService&lt;TService&gt;() without a source-generated proxy. The base client package is AOT-clean; this package opts back into runtime proxy generation.</Description>
	  <PackageTags>OutWit;Communication;WitRPC;Client;DynamicProxy</PackageTags>

	  <RepositoryUrl>https://github.com/dmitrat/WitRPC/tree/main/Communication/OutWit.Communication.Client.DynamicProxy</RepositoryUrl>

  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\OutWit.Communication.Client\OutWit.Communication.Client.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Castle.Core" />
  </ItemGroup>

</Project>
