<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
	<TargetFrameworks>net10.0;net9.0;net8.0;net7.0;net6.0</TargetFrameworks>
	<Version>3.1.0</Version>

	<Description>The core communication library of the WitRPC framework, providing base RPC functionality such as messaging, dynamic proxy support, and extensibility for multiple transports, serialization formats, and encryption.</Description>
	<PackageTags>OutWit;Communication;WitRPC</PackageTags>

	<RepositoryUrl>https://github.com/dmitrat/WitRPC/tree/main/Communication/OutWit.Communication</RepositoryUrl>

  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="OutWit.Common.Json" />
    <PackageReference Include="OutWit.Common.MemoryPack" />
    <PackageReference Include="OutWit.Common.Proxy" />
    <PackageReference Include="OutWit.Common.Reflection" />
  </ItemGroup>

</Project>
